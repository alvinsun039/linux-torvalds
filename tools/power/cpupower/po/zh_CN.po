msgstr "  -l, --hwlimits      确定允许的最小和最大 CPU 频率 *\n"

#: utils/cpufreq-info.c:480
#, c-format
msgid "  -d, --driver         Determines the used cpufreq kernel driver *\n"
msgstr "  -d, --driver         确定使用的 cpufreq 内核驱动程序*\n"

#: utils/cpufreq-info.c:481
#, c-format
msgid "  -p, --policy         Gets the currently used cpufreq policy *\n"
msgstr "  -p, --policy         获取当前使用的 cpufreq 策略*\n"

#: utils/cpufreq-info.c:482
#, c-format
msgid "  -g, --governors      Determines available cpufreq governors *\n"
msgstr "  -g, --governors      确定可用的 cpufreq 调控器 *\n"

#: utils/cpufreq-info.c:483
#, c-format
msgid ""
"  -r, --related-cpus   Determines which CPUs run at the same hardware "
"frequency *\n"
msgstr "  -a, --affected-cpus  确定哪些 CPU 以相同的硬件频率运行*\n"

#: utils/cpufreq-info.c:484
#, c-format
msgid ""
"  -a, --affected-cpus  Determines which CPUs need to have their frequency\n"
"                       coordinated by software *\n"
msgstr "  -a, --affected-cpus  确定哪些 CPU 需要由软件协调其频率 *\n"

